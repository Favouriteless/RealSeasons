{
    "schemaVersion": 1,
    "id": "realseasons",
    "version": "${version}",
    "name": "Real Seasons",
    "description": "A Serene Seasons addon to make the mod use real-time for changing seasons.",
    "authors": [
        "Favouriteless"
    ],
    "contact": {
        "homepage": "https://github.com/Favouriteless/RealSeasons"
    },
    "license": "All Rights Reserved",
    "icon": "realseasons.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "net.favouriteless.realseasons.fabric.common.RealSeasonsFabric"
        ],
        "client": [
          "net.favouriteless.realseasons.fabric.client.RealSeasonsClientFabric"
        ]
    },
    "mixins": [
        "realseasons.mixins.json",
        "realseasons.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": ">=${fabric_api_version}",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=21",
        "forgeconfigapiport": ">=${forgeconfigapi_version}"
    },
    "accessWidener" : "realseasons.accesswidener"
}
  